run = "rm -rf build/web && python3 -m zipfile -e Settliv-web.zip build/web && python3 -m http.server 3000 --directory build/web --bind 0.0.0.0"
entrypoint = "build/web/index.html"
modules = ["web"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "static"
build = ["sh", "-c", "rm -rf build/web && python3 -m zipfile -e Settliv-web.zip build/web"]
publicDir = "build/web"
